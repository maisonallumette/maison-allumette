---
import '../styles/global.css';
const { overlay = false, title = 'Maison Allumette | Réchauffez vos intérieurs', description = 'Bougies fleuries, fondants, suspensions, diffuseurs voiture et tablettes parfumées, faits main dans les Landes.' } = Astro.props;
const nav = [['Bougies','bougies'],['Fondants','fondants'],['Suspensions','suspensions'],['Voiture','voiture'],['Tablettes','tablettes']];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,700;1,500&family=Montserrat:wght@400;500;600&family=Pinyon+Script&display=swap" rel="stylesheet" />
</head>
<body class="papier-peint font-sans text-encre antialiased">
  <!-- HEADER : burger + menu à gauche, logo centré, recherche et panier à droite -->
  <header class="site fixed inset-x-0 top-0 z-30">
    <div class="mx-auto grid max-w-7xl grid-cols-3 items-center px-4 py-3">
      <div class="flex items-center gap-4">
        <button data-menu aria-label="Menu" class="md:hidden"><span class="block h-px w-6 bg-encre"></span><span class="mt-1.5 block h-px w-6 bg-encre"></span><span class="mt-1.5 block h-px w-6 bg-encre"></span></button>
        <nav class="hidden gap-6 text-xs font-semibold uppercase tracking-wider md:flex">{nav.map(([l,q]) => <a href={`/boutique?q=${q}`}>{l}</a>)}</nav>
      </div>
      <!-- LOGO provisoire en texte : à remplacer par le SVG du designer -->
      <a href="/" class="logo-wrap text-center leading-none">
        <span class="block font-script text-3xl text-olive">maison</span>
        <span class="block font-serif text-sm tracking-[.35em] text-olive">ALLUMETTE</span>
      </a>
      <div class="flex items-center justify-end gap-4 text-xs font-semibold uppercase tracking-wider">
        <a href="/boutique">Rechercher</a>
        <details class="relative">
          <summary class="flex cursor-pointer list-none items-center gap-1">Panier <span data-cart-count class="rounded-full bg-terracotta px-2 text-creme">0</span></summary>
          <div class="absolute right-0 mt-3 w-72 border border-lin bg-white p-4 shadow-lg">
            <ul data-cart-list class="space-y-2 text-sm normal-case tracking-normal"></ul>
            <p class="mt-3 flex justify-between border-t border-lin pt-3"><span>Total</span><span data-cart-total>0,00 €</span></p>
            <!-- À CONFIGURER : lien de paiement (SumUp / Stripe) -->
            <a href="#" class="mt-3 block bg-olive py-3 text-center text-creme">Valider ma commande</a>
          </div>
        </details>
      </div>
    </div>
  </header>

  <!-- MENU MOBILE (tiroir) -->
  <div data-overlay class="fixed inset-0 z-40 hidden bg-black/50"></div>
  <aside data-drawer class="fixed inset-y-0 left-0 z-50 w-[88%] max-w-sm -translate-x-full overflow-y-auto bg-white transition-transform">
    <button data-menu aria-label="Fermer" class="absolute right-3 top-3 text-2xl">×</button>
    <form action="/boutique" class="p-5 pt-12"><input name="q" type="search" placeholder="BOUGIE, FONDANT…" class="w-full bg-creme px-4 py-3 text-sm" /></form>
    <ul class="px-5 text-sm font-semibold uppercase">
      {nav.map(([l,q]) => <li class="border-b border-lin py-3"><a href={`/boutique?q=${q}`} class="flex justify-between">{l}<span>›</span></a></li>)}
      <li class="py-3"><a href="/histoire">Notre histoire</a></li><li class="py-3"><a href="/contact">Contact</a></li>
    </ul>
    <div class="vichy m-5 p-5"><p class="h-title">Offrir Maison Allumette</p><p class="mt-1 font-serif text-sm italic">Une bougie faite main, c'est le cadeau qui réchauffe.</p></div>
  </aside>

  <main class={overlay ? "" : "pt-20"}><slot /></main>

  <!-- NEWSLETTER sur fond vichy + FOOTER -->
  <section class="vichy mt-20 px-4 py-14">
    <div class="mx-auto max-w-lg bg-creme p-6 text-center">
      <p class="text-[11px] font-semibold uppercase tracking-widest">L'actualité de la Maison</p>
      <p class="mt-3 font-serif text-xl">Nouveautés et coulisses de l'atelier, directement dans votre boîte mail.</p>
      <form action="#" method="post" class="mt-4 flex"> <!-- À CONFIGURER : Brevo, MailerLite… -->
        <input type="email" required placeholder="Votre e-mail" aria-label="E-mail" class="min-w-0 flex-1 border border-lin bg-white px-3 py-3 text-sm" />
        <button class="bg-olive px-4 text-xs font-semibold uppercase text-creme">Je m'inscris</button>
      </form>
    </div>
  </section>
  <footer class="bg-olive px-4 py-12 text-creme">
    <div class="mx-auto grid max-w-6xl gap-8 text-sm md:grid-cols-3">
      <div><p class="font-script text-4xl">maison</p><p class="font-serif tracking-[.35em]">ALLUMETTE</p><p class="mt-3 text-lin">Réchauffez vos intérieurs. Fait main dans les Landes.</p></div>
      <ul class="space-y-1 text-lin"><li class="font-semibold uppercase text-creme">Conditions</li><li><a href="/cgv">CGV</a></li><li><a href="/livraison-retours">Livraison et retours</a></li><li><a href="/mentions-legales">Mentions légales</a></li><li><a href="/confidentialite">Confidentialité</a></li></ul>
      <ul class="space-y-1 text-lin"><li class="font-semibold uppercase text-creme">À propos</li><li><a href="/histoire">Notre histoire</a></li><li><a href="/contact">Contact</a></li><li><a href="https://www.instagram.com/" rel="noopener">Instagram</a></li></ul>
    </div>
    <p class="mt-10 text-center text-xs text-lin">© {new Date().getFullYear()} Maison Allumette</p>
  </footer>

  <script>
    type Item = { id: string; name: string; price: number; qty: number };
    const KEY = 'ma-cart';
    const read = (): Item[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
    const eur = (n: number) => n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });
    function render() {
      const c = read();
      document.querySelectorAll('[data-cart-count]').forEach((e) => (e.textContent = String(c.reduce((s, i) => s + i.qty, 0))));
      document.querySelector('[data-cart-total]')!.textContent = eur(c.reduce((s, i) => s + i.qty * i.price, 0));
      document.querySelector('[data-cart-list]')!.replaceChildren(...(c.length ? c.map((i) => `${i.qty} × ${i.name}`) : ['Votre panier est vide']).map((t) => { const li = document.createElement('li'); li.textContent = t; return li; }));
    }
    document.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      if (t.closest('[data-menu]') || t.closest('[data-overlay]')) {
        document.querySelector('[data-drawer]')!.classList.toggle('-translate-x-full');
        document.querySelector('[data-overlay]')!.classList.toggle('hidden'); return;
      }
      const b = t.closest<HTMLElement>('[data-add]'); if (!b) return;
      const sel = document.querySelector<HTMLSelectElement>('[data-qty]');
      const n = b.hasAttribute('data-useqty') && sel ? Number(sel.value) : 1;
      const c = read(); const f = c.find((i) => i.id === b.dataset.id);
      f ? (f.qty += n) : c.push({ id: b.dataset.id!, name: b.dataset.name!, price: Number(b.dataset.price), qty: n });
      localStorage.setItem(KEY, JSON.stringify(c)); render();
    });
    // En-tête transparent en haut de page ; le bandeau blanc apparaît quand on dépasse le logo
    const hdr = document.querySelector('header.site')!;
    const onScroll = () => hdr.classList.toggle('is-scrolled', window.scrollY > 90);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    render();
  </script>
</body>
</html>

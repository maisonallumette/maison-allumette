---
import '../styles/global.css';
import { categories, products, eur } from '../data/products';
import PhotoCadree from '../components/PhotoCadree.astro';
// bandeau : en-tête blanc en permanence (fiches produit)
const { overlay = false, bandeau = false, title = 'Maison Allumette | Réchauffez vos intérieurs', description = 'Bougies fleuries, fondants, suspensions, diffuseurs voiture et tablettes parfumées, faits main dans les Landes.' } = Astro.props;
// La catégorie « Collections capsules » a sa place à droite de l'en-tête, les autres à gauche
const estCapsule = (slug: string) => /^collections?-capsules?$/.test(slug);
const capsule = categories.find((c) => estCapsule(c.slug));
const navOrdi = categories.filter((c) => !estCapsule(c.slug));
// Pour ne pas passer sous le logo : 4 catégories sur un écran moyen, 6 sur un grand, puis « Tout voir » renvoie vers la boutique
const NAV_MOYEN = 4, NAV_GRAND = 6;
const produitsDe = (slug: string) => products.filter((p) => p.category === slug);
const ligne = 'flex items-center justify-between gap-4 py-4';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title><meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,700;1,500&family=Montserrat:wght@400;500;600&family=Pinyon+Script&display=swap" rel="stylesheet" />
</head>
<body class="papier-peint font-sans text-encre antialiased">
  <!-- HEADER : burger + menu à gauche, logo centré, recherche et panier à droite -->
  <header class:list={["site fixed inset-x-0 top-0 z-30", bandeau && "is-scrolled"]} data-bandeau={bandeau || undefined}>
    <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 px-4 py-3 xl:px-6">
      <div class="flex items-center gap-4">
        <button data-menu aria-label="Menu" aria-controls="panneau" class="xl:hidden"><span class="block h-px w-6 bg-encre"></span><span class="mt-1.5 block h-px w-6 bg-encre"></span><span class="mt-1.5 block h-px w-6 bg-encre"></span></button>
        <nav class="hidden gap-5 whitespace-nowrap text-xs font-semibold uppercase tracking-wider xl:flex">
          {navOrdi.map((c, i) => <a href={`/boutique?categorie=${c.slug}`} data-ouvre={c.slug} aria-controls="panneau" class:list={[i >= NAV_GRAND ? 'hidden' : i >= NAV_MOYEN && 'hidden 2xl:block']}>{c.name}</a>)}
          {navOrdi.length > NAV_MOYEN && <a href="/boutique" class:list={[navOrdi.length <= NAV_GRAND && '2xl:hidden']}>Tout voir</a>}
        </nav>
      </div>
      <!-- LOGO provisoire en texte : à remplacer par le SVG du designer -->
      <a href="/" class="logo-wrap text-center leading-none">
        <span class="block font-script text-3xl text-olive">maison</span>
        <span class="block font-serif text-sm tracking-[.35em] text-olive">ALLUMETTE</span>
      </a>
      <!-- Collections capsules (sur ordinateur ; dans le tiroir sur mobile), puis loupe et panier tout à droite -->
      <div class="flex items-center justify-end gap-4 text-xs font-semibold uppercase tracking-wider md:gap-5">
        {capsule && <a href={`/boutique?categorie=${capsule.slug}`} data-ouvre={capsule.slug} aria-controls="panneau" class="hidden whitespace-nowrap xl:block">{capsule.name}</a>}
        <a href="/boutique" data-ouvre-recherche aria-controls="panneau" aria-label="Rechercher"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></a>
        <details class="relative">
          <summary aria-label="Panier" class="relative block cursor-pointer list-none"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-6"><path d="M6 8h12l1 12H5L6 8Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/></svg><span data-cart-count class="absolute -right-1.5 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-terracotta px-1 text-[10px] tracking-normal text-creme">0</span></summary>
          <div class="absolute right-0 mt-3 w-72 border border-lin bg-white p-4 shadow-lg">
            <ul data-cart-list class="space-y-2 text-sm normal-case tracking-normal"></ul>
            <p class="mt-3 flex justify-between border-t border-lin pt-3"><span>Total</span><span data-cart-total>0,00 €</span></p>
            <!-- À CONFIGURER : lien de paiement (SumUp / Stripe) -->
            <a href="#" class="mt-3 block bg-olive py-3 text-center text-creme">Valider ma commande</a>
          </div>
        </details>
      </div>
    </div>
  </header>

  <!-- PANNEAU DU MENU : ouvert par une catégorie, la loupe ou le burger. Onglets des catégories, recherche, sous-catégories, produits -->
  <!-- Le panneau et le voile apparaissent en fondu ; le reste du site devient flou derrière -->
  <div data-overlay class="fondu fixed inset-0 z-40 bg-encre/30 backdrop-blur-md"></div>
  <aside id="panneau" data-panneau role="dialog" aria-modal="true" aria-label="Menu de la boutique" inert class="fondu fixed inset-y-2 left-2 z-50 flex w-[88%] max-w-md bg-white shadow-2xl md:inset-y-6 md:left-6 lg:w-auto lg:max-w-[calc(100vw-3rem)]">
    <div class="flex w-full flex-col overflow-y-auto lg:w-[30rem] lg:flex-none">
      <div class="flex items-start gap-3 border-b border-lin px-6 pb-3 pt-6">
        <div class="flex flex-1 flex-wrap gap-x-5 gap-y-3 text-xs font-semibold uppercase tracking-wider">
          {categories.map((c) => <button type="button" data-onglet={c.slug} aria-pressed="false" class="border-b-2 border-transparent pb-1 text-left uppercase aria-pressed:border-terracotta">{c.name}</button>)}
        </div>
        <button type="button" data-fermer aria-label="Fermer le menu" class="-mr-2 -mt-2 flex size-10 flex-none items-center justify-center border border-lin transition-colors hover:border-olive hover:bg-creme"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-5"><path d="M5 5l14 14M19 5 5 19"/></svg></button>
      </div>
      <form action="/boutique" role="search" class="mx-6 mt-5 flex bg-creme">
        <input data-recherche name="q" type="search" placeholder="Bougie, fondant, fleurs…" aria-label="Rechercher un produit" class="min-w-0 flex-1 bg-transparent px-4 py-3 text-base md:text-sm" />
        <button aria-label="Lancer la recherche" class="px-3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-5"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></button>
      </form>
      <!-- Chaque ligne : le nom mène à la page, la flèche « › » agrandit le cadre vers la droite pour en montrer plus -->
      {categories.map((c) => {
        const liste = produitsDe(c.slug);
        const lignes = c.subcategories.length > 0
          ? c.subcategories.map((s) => ({ href: `/boutique?categorie=${c.slug}&sous=${s.slug}`, nom: s.name, cle: `sous/${c.slug}/${s.slug}`, aide: `Voir les produits : ${s.name}` }))
          : liste.map((p) => ({ href: `/produits/${p.slug}`, nom: p.name, cle: `produit/${p.slug}`, aide: `Aperçu : ${p.name}` }));
        return (
          <div data-section={c.slug} hidden class="px-6 pt-3">
            <ul class="divide-y divide-lin text-sm font-semibold uppercase tracking-wider">
              {lignes.map((l) => (
                <li class="flex items-stretch gap-2">
                  <a href={l.href} class="flex-1 py-4">{l.nom}</a>
                  <button type="button" data-detail-btn={l.cle} aria-expanded="false" aria-controls="panneau-cote" aria-label={l.aide} class="w-10 flex-none text-lg transition-colors hover:bg-creme aria-expanded:bg-creme">›</button>
                </li>
              ))}
              <li><a href={`/boutique?categorie=${c.slug}`} class={`${ligne} normal-case tracking-normal underline underline-offset-4`}>Voir tout : {c.name}<span aria-hidden="true" class="inline-block">›</span></a></li>
            </ul>
            {liste.length === 0 && <p class="pb-2 font-serif italic">De nouvelles créations arrivent bientôt.</p>}
          </div>
        );
      })}
      <ul class="mx-6 mt-4 border-t border-lin pt-3 text-xs font-semibold uppercase tracking-wider">
        <li><a href="/histoire" class="block py-2">Notre histoire</a></li>
        <li><a href="/contact" class="block py-2">Contact</a></li>
      </ul>
      <a href="/carte-cadeau" class="vichy group m-6 mt-auto block p-5"><span class="flex items-center justify-between gap-3 bg-creme/90 p-4"><span><span class="h-title block">Offrir Maison Allumette</span><span class="mt-1 block font-serif text-sm italic">La carte cadeau, avec un petit mot écrit à la main.</span></span><span aria-hidden="true" class="transition-transform group-hover:translate-x-1">›</span></span></a>
    </div>
    <!-- Colonne de droite (grand écran) : deux produits de la catégorie, ou le détail ouvert par une flèche « › ».
         Sur téléphone, le détail s'affiche par-dessus le menu, avec un bouton Retour. -->
    <div id="panneau-cote" data-cote class="cote">
      {categories.map((c) => (
        <div data-section={c.slug} hidden class="space-y-8 p-6">
          {produitsDe(c.slug).slice(0, 2).map((p) => (
            <a href={`/produits/${p.slug}`} class="block">
              <PhotoCadree p={p} loading="lazy" />
              <p class="h-title mt-3 text-sm">{p.name}</p>
              <p class="mt-1 font-serif text-sm italic underline underline-offset-4">Découvrir</p>
            </a>
          ))}
        </div>
      ))}
      {categories.flatMap((c) => c.subcategories.map((s) => {
        const liste = produitsDe(c.slug).filter((p) => p.subcategory === s.slug);
        return (
          <div data-detail={`sous/${c.slug}/${s.slug}`} hidden class="p-6">
            <button type="button" data-retour class="text-xs font-semibold uppercase tracking-wider">‹ Retour</button>
            <h2 class="h-title mt-4 text-lg">{s.name}</h2>
            {liste.length > 0
              ? <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-6">{liste.map((p) => (
                  <li><a href={`/produits/${p.slug}`} class="block"><PhotoCadree p={p} loading="lazy" /><span class="h-title mt-2 block text-xs">{p.name}</span><span class="mt-1 block text-sm">{eur(p.price)}</span></a></li>
                ))}</ul>
              : <p class="mt-6 font-serif italic">De nouvelles créations arrivent bientôt.</p>}
            <a href={`/boutique?categorie=${c.slug}&sous=${s.slug}`} class="mt-8 block border border-olive py-3 text-center text-xs font-semibold uppercase tracking-wider">Voir tout : {s.name}</a>
          </div>
        );
      }))}
      {categories.filter((c) => c.subcategories.length === 0).flatMap((c) => produitsDe(c.slug)).map((p) => (
        <div data-detail={`produit/${p.slug}`} hidden class="p-6">
          <button type="button" data-retour class="text-xs font-semibold uppercase tracking-wider">‹ Retour</button>
          <div class="mt-4 max-w-sm"><PhotoCadree p={p} loading="lazy" /></div>
          <h2 class="h-title mt-4 text-lg">{p.name}</h2>
          {p.short && <p class="mt-1 font-serif italic">{p.short}</p>}
          <p class="mt-2 text-sm font-semibold">{eur(p.price)}</p>
          <a href={`/produits/${p.slug}`} class="mt-6 block max-w-sm border border-olive py-3 text-center text-xs font-semibold uppercase tracking-wider">Découvrir</a>
        </div>
      ))}
    </div>
  </aside>

  <main class={overlay ? "" : "pt-20"}><slot /></main>

  <!-- NEWSLETTER sur fond vichy + FOOTER -->
  <section class="vichy mt-20 px-4 py-14">
    <div class="mx-auto max-w-lg bg-creme p-6 text-center">
      <p class="text-[11px] font-semibold uppercase tracking-widest">L'actualité de la Maison</p>
      <p class="mt-3 font-serif text-xl">Nouveautés et coulisses de l'atelier, directement dans votre boîte mail.</p>
      <form action="#" method="post" class="mt-4 flex"> <!-- À CONFIGURER : Brevo, MailerLite… -->
        <input type="email" required placeholder="Votre e-mail" aria-label="E-mail" class="min-w-0 flex-1 border border-lin bg-white px-3 py-3 text-sm" />
        <button class="bg-olive px-4 text-xs font-semibold uppercase text-creme">Je m'inscris</button>
      </form>
    </div>
  </section>
  <footer class="bg-olive px-4 py-12 text-creme">
    <div class="mx-auto grid max-w-6xl gap-8 text-sm md:grid-cols-3">
      <div class="flex flex-col items-center md:items-start"><span role="img" aria-label="Maison Allumette, Réchauffez vos intérieurs" class="logo-ovale w-36 text-creme"></span><p class="mt-4 text-lin">Fait main dans les Landes.</p></div>
      <ul class="space-y-1 text-lin"><li class="font-semibold uppercase text-creme">Conditions</li><li><a href="/cgv">CGV</a></li><li><a href="/livraison-retours">Livraison et retours</a></li><li><a href="/mentions-legales">Mentions légales</a></li><li><a href="/confidentialite">Confidentialité</a></li></ul>
      <ul class="space-y-1 text-lin"><li class="font-semibold uppercase text-creme">À propos</li><li><a href="/histoire">Notre histoire</a></li><li><a href="/carte-cadeau">Carte cadeau</a></li><li><a href="/contact">Contact</a></li><li><a href="https://www.instagram.com/" rel="noopener">Instagram</a></li></ul>
    </div>
    <p class="mt-10 text-center text-xs text-lin">© {new Date().getFullYear()} Maison Allumette</p>
  </footer>

  <script>
    // details : informations d'une carte cadeau (destinataire, adresse, petit mot), gardées pour la commande
    type Item = { id: string; name: string; price: number; qty: number; details?: Record<string, string> };
    const KEY = 'ma-cart';
    const read = (): Item[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
    const eur = (n: number) => n.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR' });
    function render() {
      const c = read();
      document.querySelectorAll('[data-cart-count]').forEach((e) => (e.textContent = String(c.reduce((s, i) => s + i.qty, 0))));
      document.querySelector('[data-cart-total]')!.textContent = eur(c.reduce((s, i) => s + i.qty * i.price, 0));
      document.querySelector('[data-cart-list]')!.replaceChildren(...(c.length ? c.map((i) => `${i.qty} × ${i.name}`) : ['Votre panier est vide']).map((t) => { const li = document.createElement('li'); li.textContent = t; return li; }));
    }
    // Panneau du menu
    const panneau = document.querySelector<HTMLElement>('[data-panneau]')!;
    const voile = document.querySelector<HTMLElement>('[data-overlay]')!;
    const cote = panneau.querySelector<HTMLElement>('[data-cote]')!;
    const onglets = [...panneau.querySelectorAll<HTMLElement>('[data-onglet]')];
    const grandEcran = matchMedia('(min-width: 64rem)');
    let ouvert = false, choisi = '', detail = '', retour: HTMLElement | null = null, boutonDetail: HTMLElement | null = null;
    // Colonne de droite : produits de la catégorie, ou détail ouvert par une flèche « › » (le cadre s'élargit)
    function majCote() {
      cote.querySelectorAll<HTMLElement>('[data-section]').forEach((s) => (s.hidden = Boolean(detail) || s.dataset.section !== choisi));
      cote.querySelectorAll<HTMLElement>('[data-detail]').forEach((d) => (d.hidden = d.dataset.detail !== detail));
      cote.classList.toggle('avec-detail', Boolean(detail));
      cote.classList.toggle('vide', !detail && !cote.querySelector(`[data-section="${choisi}"] a`));
      panneau.querySelectorAll<HTMLElement>('[data-detail-btn]').forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.detailBtn === detail)));
    }
    function choisir(slug: string, force = false) {
      if (slug === choisi && !force) return;
      choisi = slug; detail = '';
      onglets.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.onglet === slug)));
      panneau.querySelectorAll<HTMLElement>('[data-section]').forEach((s) => (s.hidden = s.dataset.section !== slug));
      majCote();
    }
    function montrerDetail(bouton: HTMLElement) {
      if (detail === bouton.dataset.detailBtn) { fermerDetail(); return; }
      detail = bouton.dataset.detailBtn!; boutonDetail = bouton;
      majCote();
      // Sur téléphone, le détail recouvre le menu : on place le curseur sur « Retour »
      if (!grandEcran.matches) cote.querySelector<HTMLElement>(`[data-detail="${detail}"] [data-retour]`)?.focus();
    }
    function fermerDetail() {
      detail = '';
      majCote();
      boutonDetail?.focus();
    }
    function ouvrir(slug: string, recherche = false) {
      if (!ouvert) retour = document.activeElement as HTMLElement | null;
      choisir(slug || choisi || onglets[0]?.dataset.onglet || '', true);
      ouvert = true;
      panneau.inert = false;
      [panneau, voile].forEach((e) => e.classList.add('est-ouvert'));
      document.documentElement.style.overflow = 'hidden';
      const cible = recherche ? panneau.querySelector<HTMLElement>('[data-recherche]') : onglets.find((b) => b.dataset.onglet === choisi);
      cible?.focus();
    }
    function fermer() {
      if (!ouvert) return;
      ouvert = false;
      panneau.inert = true;
      [panneau, voile].forEach((e) => e.classList.remove('est-ouvert'));
      document.documentElement.style.overflow = '';
      retour?.focus();
    }
    // À la souris, survoler un onglet suffit pour changer de catégorie
    onglets.forEach((b) => b.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') choisir(b.dataset.onglet!); }));
    document.addEventListener('keydown', (ev) => {
      if (!ouvert) return;
      if (ev.key === 'Escape') { if (detail) fermerDetail(); else fermer(); return; }
      // La touche Tab reste dans le panneau tant qu'il est ouvert
      if (ev.key !== 'Tab') return;
      const liens = [...panneau.querySelectorAll<HTMLElement>('a[href], button, input')].filter((e) => e.offsetParent !== null);
      const premier = liens[0], dernier = liens.at(-1);
      if (ev.shiftKey && document.activeElement === premier) { ev.preventDefault(); dernier?.focus(); }
      else if (!ev.shiftKey && document.activeElement === dernier) { ev.preventDefault(); premier?.focus(); }
    });
    document.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const cat = t.closest<HTMLElement>('[data-ouvre]');
      if (cat) { ev.preventDefault(); ouvrir(cat.dataset.ouvre!); return; }
      if (t.closest('[data-ouvre-recherche]')) { ev.preventDefault(); ouvrir('', true); return; }
      if (t.closest('[data-menu]')) { ouvrir(''); return; }
      if (t.closest('[data-fermer]') || t.closest('[data-overlay]')) { fermer(); return; }
      const onglet = t.closest<HTMLElement>('[data-onglet]');
      if (onglet) { choisir(onglet.dataset.onglet!); return; }
      const fleche = t.closest<HTMLElement>('[data-detail-btn]');
      if (fleche) { montrerDetail(fleche); return; }
      if (t.closest('[data-retour]')) { fermerDetail(); return; }
      const b = t.closest<HTMLElement>('[data-add]'); if (!b) return;
      // La quantité est le menu déroulant voisin du bouton
      const sel = b.parentElement?.querySelector<HTMLSelectElement>('[data-qty]');
      const n = b.hasAttribute('data-useqty') && sel ? Number(sel.value) : 1;
      const c = read(); const f = c.find((i) => i.id === b.dataset.id);
      f ? (f.qty += n) : c.push({ id: b.dataset.id!, name: b.dataset.name!, price: Number(b.dataset.price), qty: n });
      localStorage.setItem(KEY, JSON.stringify(c)); render();
    });
    // En-tête transparent en haut de page ; le bandeau blanc apparaît quand on dépasse le logo
    const hdr = document.querySelector('header.site')!;
    const onScroll = () => hdr.classList.toggle('is-scrolled', hdr.hasAttribute('data-bandeau') || window.scrollY > 90);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    // Une autre page (carte cadeau) a modifié le panier
    window.addEventListener('panier-change', render);
    render();
  </script>
</body>
</html>

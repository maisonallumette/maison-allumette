---
// Fiche produit en trois cadres : bandeau blanc en haut, photo à gauche (fixe pendant le défilement), informations à droite.
// Sur téléphone : photo, puis informations, et barre d'achat fixée en bas.
import Base from '../../layouts/Base.astro';
import PhotoCadree from '../../components/PhotoCadree.astro';
import { products, eur, categoryName, subcategoryName } from '../../data/products';
import { VENTE_EN_LIGNE } from '../../data/site';
export function getStaticPaths() { return products.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const cat = categoryName(p.category);
const sous = subcategoryName(p.category, p.subcategory);
const QUANTITES = [1, 2, 3, 4, 5, 6];
const rubrique = 'group border-b border-lin';
const titreRubrique = 'flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-xs font-semibold uppercase tracking-wider [&::-webkit-details-marker]:hidden';
const plus = 'text-lg font-normal leading-none transition-transform group-open:rotate-45';
---
<Base title={`${p.name} | Maison Allumette`} description={p.short} bandeau>
  <article class="md:grid md:grid-cols-2">
    <!-- CADRE 2 : la photo, posée sur le lin olive de la marque (texture tirée d'un visuel de la graphiste) -->
    <div class="bg-olive bg-[url(/images/fond-lin-olive.jpg)] bg-[length:880px] px-8 py-10 md:sticky md:top-20 md:flex md:h-[calc(100svh-5rem)] md:items-center md:justify-center md:p-10">
      <div class="mx-auto w-full max-w-md shadow-[0_18px_40px_rgba(0,0,0,.45)] md:mx-0 md:max-w-[min(34rem,calc(100svh-10rem))]"><PhotoCadree p={p} /></div>
    </div>

    <!-- CADRE 3 : les informations -->
    <div class="bg-creme px-5 py-8 md:min-h-[calc(100svh-5rem)] md:px-10 md:py-16 lg:px-20">
      <div class="md:max-w-lg">
        <nav aria-label="Fil d'Ariane" class="text-[11px] font-semibold uppercase tracking-wider text-encre/70">
          <a href="/">Accueil</a>
          {cat && <><span aria-hidden="true" class="mx-1.5">/</span><a href={`/boutique?categorie=${p.category}`}>{cat}</a></>}
          {sous && <><span aria-hidden="true" class="mx-1.5">/</span><a href={`/boutique?categorie=${p.category}&sous=${p.subcategory}`}>{sous}</a></>}
        </nav>
        <!-- Sur petit écran, le prix passe sous le nom pour ne pas déborder -->
        <div class="mt-5 flex flex-col gap-2 min-[400px]:flex-row min-[400px]:items-start min-[400px]:justify-between min-[400px]:gap-6">
          <h1 class="h-title min-w-0 text-3xl leading-tight">{p.name}</h1>
          <p class="pt-1 text-lg font-semibold whitespace-nowrap">{eur(p.price)}</p>
        </div>
        {p.short && <p class="mt-3 font-serif text-lg italic">{p.short}</p>}

        <!-- Achat sur tablette et ordinateur (seulement si la vente en ligne est ouverte) -->
        {VENTE_EN_LIGNE && <div class="mt-8 hidden md:flex">
          <select data-qty aria-label="Quantité" class="w-20 border border-r-0 border-terracotta bg-white px-3 text-sm">{QUANTITES.map((n) => <option>{n}</option>)}</select>
          <button data-add data-useqty data-id={p.slug} data-name={p.name} data-price={p.price} class="flex-1 bg-terracotta py-4 text-xs font-semibold uppercase tracking-wider text-creme transition-colors hover:bg-olive">Ajouter au panier</button>
        </div>}

        {(p.description || p.notes.length > 0) && (
          <div class="mt-8 border-b border-lin pb-6 md:border-t md:pt-6">
            {p.description && <p class="whitespace-pre-line text-sm/6">{p.description}</p>}
            {p.notes.length > 0 && <ul class="mt-4 space-y-1 text-sm">{p.notes.map((n) => <li>· {n}</li>)}</ul>}
          </div>
        )}
        {p.conseils && (
          <details class={rubrique}><summary class={titreRubrique}>Conseils d'utilisation<span aria-hidden="true" class={plus}>+</span></summary>
            <p class="whitespace-pre-line pb-5 text-sm/6">{p.conseils}</p></details>
        )}
        {p.composition && (
          <details class={rubrique}><summary class={titreRubrique}>Composition<span aria-hidden="true" class={plus}>+</span></summary>
            <p class="whitespace-pre-line pb-5 text-sm/6">{p.composition}</p></details>
        )}
      </div>
    </div>
  </article>

  {VENTE_EN_LIGNE && (
    <>
      <!-- Achat sur téléphone : barre fixée en bas -->
      <div class="fixed inset-x-0 bottom-0 z-20 border-t border-lin bg-white md:hidden">
        <p class="py-2 text-center text-sm">{eur(p.price)}</p>
        <div class="flex">
          <button data-add data-useqty data-id={p.slug} data-name={p.name} data-price={p.price} class="flex-1 bg-terracotta py-4 text-xs font-semibold uppercase tracking-wider text-creme">Ajouter au panier</button>
          <select data-qty aria-label="Quantité" class="w-20 bg-lin px-3 text-sm">{QUANTITES.map((n) => <option>{n}</option>)}</select>
        </div>
      </div>
      <!-- Sur téléphone, réserve la hauteur de la barre d'achat pour qu'elle ne masque pas le bas du pied de page -->
      <style is:global>body { padding-bottom: 5.75rem; } @media (min-width: 48rem) { body { padding-bottom: 0; } }</style>
    </>
  )}
</Base>

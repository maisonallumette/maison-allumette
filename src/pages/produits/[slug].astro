---
import Base from '../../layouts/Base.astro';
import { products, eur } from '../../data/products';
export function getStaticPaths() { return products.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
---
<Base title={`${p.name} | Maison Allumette`} description={p.short}>
  <article class="md:mx-auto md:grid md:max-w-6xl md:grid-cols-2 md:gap-10 md:px-4">
    <img src={p.image} alt={p.name} class="aspect-square w-full object-cover" />
    <div class="bg-creme p-5 md:bg-transparent md:p-0">
      <div class="flex justify-between gap-4"><h1 class="h-title text-3xl leading-tight">{p.name}</h1><p class="text-lg font-semibold">{eur(p.price)}</p></div>
      <p class="mt-2 font-serif italic">{p.short}</p>
      <details open class="mt-6 border-t border-lin py-3"><summary class="cursor-pointer text-xs font-semibold uppercase tracking-wider">Description</summary>
        <p class="mt-3 text-sm/6">{p.description}</p><ul class="mt-3 space-y-1 text-sm">{p.notes.map((n) => <li>· {n}</li>)}</ul></details>
      <!-- À COMPLÉTER : conseils d'utilisation, composition, numéro de lot -->
      <details class="border-t border-lin py-3"><summary class="cursor-pointer text-xs font-semibold uppercase tracking-wider">Conseils d'utilisation</summary><p class="mt-3 text-sm/6">À compléter.</p></details>
      <details class="border-y border-lin py-3"><summary class="cursor-pointer text-xs font-semibold uppercase tracking-wider">Composition</summary><p class="mt-3 text-sm/6">À compléter.</p></details>
    </div>
  </article>
  <!-- BARRE D'ACHAT FIXE EN BAS -->
  <div class="fixed inset-x-0 bottom-0 z-20 border-t border-lin bg-white">
    <p class="py-2 text-center text-sm">{eur(p.price)}</p>
    <div class="flex">
      <button data-add data-useqty data-id={p.slug} data-name={p.name} data-price={p.price} class="flex-1 bg-terracotta py-4 text-xs font-semibold uppercase tracking-wider text-creme">Ajouter au panier</button>
      <select data-qty aria-label="Quantité" class="w-20 bg-lin px-3 text-sm">{[1,2,3,4,5,6].map((n) => <option>{n}</option>)}</select>
    </div>
  </div>
  <!-- Réserve la hauteur de la barre d'achat pour qu'elle ne masque pas le bas du pied de page -->
  <style is:global>body { padding-bottom: 5.75rem; }</style>
</Base>

---
import Base from '../../layouts/Base.astro';
import { products, eur } from '../../data/products';
export function getStaticPaths() { return products.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
---
<Base title={`${p.name} | Maison Allumette`} description={p.short}>
  <article class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-2">
    <img src={p.image} alt={p.name} class="aspect-square w-full rounded-3xl object-cover" />
    <div>
      <p class="text-xs uppercase tracking-[.2em] text-cuivre">{p.category}</p>
      <h1 class="mt-2 font-serif text-5xl">{p.name}</h1>
      <p class="mt-3 text-2xl">{eur(p.price)}</p>
      <p class="mt-5 text-base/7">{p.description}</p>
      <ul class="mt-5 space-y-1 text-sm">{p.notes.map((n) => <li>· {n}</li>)}</ul>
      <button data-add data-id={p.slug} data-name={p.name} data-price={p.price}
        class="mt-8 w-full rounded-full bg-sapin px-8 py-4 text-sm font-medium text-creme transition hover:bg-cuivre md:w-auto">Ajouter au panier</button>
      <p class="mt-4 text-xs text-encre/70">Livraison soignée · Paiement sécurisé · 14 jours pour changer d’avis</p>
    </div>
  </article>
</Base>

---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---
<Base title="Boutique | Maison Allumette">
  <section class="mx-auto max-w-6xl px-4 pt-12">
    <h1 class="font-serif text-5xl">La boutique</h1>
    <p data-empty hidden class="mt-6 text-sm">Aucun produit ne correspond à votre recherche.</p>
    <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
      {products.map((p) => <ProductCard p={p} />)}
    </div>
  </section>
  <!-- Filtre la grille avec ?q= (barre de recherche du header) -->
  <script>
    const q = (new URLSearchParams(location.search).get('q') || '').toLowerCase().trim();
    if (q) {
      let n = 0;
      document.querySelectorAll<HTMLElement>('[data-search]').forEach((el) => {
        const ok = el.dataset.search!.includes(q); el.hidden = !ok; if (ok) n++;
      });
      document.querySelector<HTMLElement>('[data-empty]')!.hidden = n > 0;
    }
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Seal from '../components/Seal.astro';
import { products } from '../data/products';
const tiles = [['Bougies','bougies'],['Fondants','fondants'],['Tablettes','tablettes'],['Voiture','voiture']];
const reassurance = [['Paiement sécurisé','Carte bancaire via un prestataire certifié.'],['Livraison soignée','Colis emballé à la main, expédié depuis Mont-de-Marsan.'],['Fait main','Cire végétale, fragrances de Grasse, fleurs séchées d’ici.'],['Écrivez-nous','Une question ? Nous répondons avec plaisir.']];
---
<Base overlay>
  <!-- HERO : photo en haut sur mobile ; volet crème + photo côte à côte sur grand écran -->
  <section class="grid md:min-h-[85vh] md:grid-cols-2">
    <div class="relative order-first h-[55vh] bg-sauge md:order-last md:h-auto">
      <img src="/placeholder.svg" alt="Bougie allumée près d'une fenêtre" class="size-full object-cover" /> <!-- Photo ambiance à fournir -->
      <Seal class="absolute bottom-4 right-4 w-28 md:w-36" />
    </div>
    <div class="flex min-w-0 flex-col items-center justify-center px-4 py-14 text-center md:px-6">
      <div class="bg-creme/95 px-5 py-10 shadow-sm md:px-8"><p class="text-[11px] font-semibold uppercase tracking-[.3em]">Fait main dans les Landes</p>
      <h1 class="h-title mt-3 text-[clamp(1.75rem,9.5vw,3rem)] leading-none md:text-[clamp(2rem,4.2vw,3.75rem)]">Réchauffez<br />vos intérieurs</h1>
      <p class="mt-5 max-w-sm font-serif text-lg italic">Bougies fleuries, fondants et parfums d’intérieur, en cire végétale et fragrances de Grasse.</p>
      <a href="/boutique" class="mt-8 inline-block border border-olive bg-white px-10 py-3 text-xs font-semibold uppercase tracking-wider transition hover:bg-olive hover:text-creme">Acheter maintenant</a></div>
    </div>
  </section>

  <!-- PRODUITS VEDETTES -->
  <section class="mx-auto max-w-6xl px-4 pt-16">
    <h2 class="h-title border-b border-lin pb-3 text-xl">Nos coups de cœur</h2>
    <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-4">{products.slice(0, 4).map((p) => <ProductCard p={p} />)}</div>
    <a href="/boutique" class="mt-10 block border border-lin py-3 text-center text-xs font-semibold uppercase tracking-wider">Toute la gamme</a>
  </section>

  <!-- TUILES DE CATÉGORIES (photos à fournir) -->
  <section class="mx-auto mt-12 grid max-w-6xl grid-cols-2 gap-2 px-4 md:grid-cols-4">
    {tiles.map(([l, q]) => (
      <a href={`/boutique?q=${q}`} class="flex aspect-[4/3] items-end justify-center bg-sauge p-4"><h3 class="h-title text-2xl text-creme">{l}</h3></a>))}
  </section>

  <!-- RÉASSURANCE -->
  <section class="mx-auto mt-16 grid max-w-6xl grid-cols-2 border-y border-lin px-4 md:grid-cols-4">
    {reassurance.map(([t, d]) => <div class="border-b border-lin p-6 text-center md:border-b-0"><p class="h-title text-sm">{t}</p><p class="mt-2 font-serif text-sm italic">{d}</p></div>)}
  </section>
</Base>

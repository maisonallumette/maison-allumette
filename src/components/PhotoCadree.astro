---
// Photo de produit dans un carré, avec le cadrage choisi dans /admin/.
import { styleCadrage } from '../data/cadrage';
const { p, loading } = Astro.props;
---
<div class="relative aspect-square w-full overflow-hidden bg-lin">
  <img src={p.image} alt={p.name} loading={loading} style={styleCadrage(p.cadrage)} class="absolute inset-0 size-full object-cover" />
</div>

---
// Sceau rond officiel de la graphiste (encre orange sur crème). Le léger zoom masque les coins noirs du JPEG.
const { class: c = '' } = Astro.props;
---
<span class={`block overflow-hidden rounded-full shadow-md ${c}`}>
  <img src="/brand/ma-sceau-creme.jpg" alt="Maison Allumette, Homemade in Landes, 2021" width="928" height="928" class="block scale-[1.03]" />
</span>

---
// Sceau rond de la marque : logo de la graphiste en crème sur disque orange
const { class: c = '' } = Astro.props;
---
<span role="img" aria-label="Maison Allumette, Homemade in Landes, 2021" class={`block aspect-square rounded-full bg-terracotta p-1 text-creme ${c}`}>
  <span class="logo-ronde w-full"></span>
</span>

---
import { eur } from '../data/products';
const { p } = Astro.props;
---
<article class="group flex flex-col" data-search={`${p.name} ${p.category}`.toLowerCase()}>
  <a href={`/produits/${p.slug}`} class="block aspect-square overflow-hidden rounded-2xl bg-lin/40">
    <img src={p.image} alt={p.name} loading="lazy" class="size-full object-cover transition duration-500 group-hover:scale-105" />
  </a>
  <div class="mt-3 flex-1">
    <p class="text-[11px] uppercase tracking-[.2em] text-cuivre">{p.category}</p>
    <h3 class="font-serif text-2xl leading-tight"><a href={`/produits/${p.slug}`}>{p.name}</a></h3>
    <p class="mt-1 text-sm">{eur(p.price)}</p>
  </div>
  <button data-add data-id={p.slug} data-name={p.name} data-price={p.price}
    class="mt-3 rounded-full bg-sapin px-4 py-3 text-sm text-creme transition hover:bg-cuivre">Ajouter au panier</button>
</article>
